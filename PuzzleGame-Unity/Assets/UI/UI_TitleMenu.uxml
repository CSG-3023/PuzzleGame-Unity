<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" path="Assets/UI/UI_TitleMenu.uxml" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/UI_Style_CSG.uss?fileID=7433441132597879392&amp;guid=508588f47bff4384b708f2fbc9f1e865&amp;type=3#UI_Style_CSG"/>
    <ui:VisualElement name="Root" class="root-container">
        <ui:VisualElement name="Sidebar" class="sidebar">
            <ui:VisualElement name="Header" class="header-container">
                <ui:Label text="GAME TITLE" name="GameTitle" class="font-header"/>
                <ui:Label text="Designed By: Your Name Here" name="Byline" class="font-body"/>
            </ui:VisualElement>
            <ui:VisualElement name="Body" class="button-container">
                <ui:Button text="PLAY" name="BTN_Play" class="menu-button font-header"/>
                <ui:Button text="INSTRUCTIONS" name="BTN_Instructions" class="menu-button font-header"/>
                <ui:Button text="QUIT" name="BTN_Quit" class="menu-button font-header"/>
            </ui:VisualElement>
            <ui:VisualElement name="Footer" class="footer-container">
                <ui:Image source="project://database/Assets/Sprites/26-CSG-Logo-TU.png?fileID=2800000&amp;guid=30809913ddca820409f9ff1225d58e0b&amp;type=3#26-CSG-Logo-TU" name="IMG_Logo"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ContentArea" class="content-area">
            <ui:VisualElement name="PNL_Instructions" class="instructions-panel panel-content hidden">
                <ui:Button text="✕" name="BTN_Close" class="close-button font-open-sans font-body"/>
                <ui:Label text="INSTRUCTIONS" name="TXT_Header" class="font-header panel-header"/>
                <ui:Label text="Instruction information goes here" name="TXT_Body" class="panel-body font-body"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
